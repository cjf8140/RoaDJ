<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- 왼쪽 위 실시간 속도 + 차량/내비 정보 -->
    <LinearLayout
        android:id="@+id/layout_top_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:gravity="top">

        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:visibility="gone"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <LinearLayout
            android:id="@+id/layout_vehicle_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_navi_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="내비: 연결 대기 중"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tv_current_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 위치: --"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tv_destination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 목적지: --"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tv_weather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="날씨: --"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tv_weather_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#888888" />

            <TextView
                android:id="@+id/tv_month_season"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="현재 월: --"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tv_sun_times"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="일출/일몰: --"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tv_nearby"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주변 정보: --"
                android:textSize="14sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tv_nearby_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#888888" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 인터넷 상태 디스플레이 -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인터넷 상태 대기 중"
            android:textSize="16sp"
            android:textColor="#666666" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- 실시간 속도 토글 버튼 -->
        <Button
            android:id="@+id/btn_get_speed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="실시간 속도 시작"
            android:textSize="18sp"
            android:paddingVertical="12dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- 인터넷 테스트 버튼 -->
        <Button
            android:id="@+id/btn_test_internet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="인터넷 연결 테스트"
            android:textSize="18sp"
            android:paddingVertical="12dp" />

    </LinearLayout>
    <!-- 로컬 오디오 플레이어 (assets/audio) -->
    <LinearLayout
        android:id="@+id/layout_player"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_ranking_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="곡 언어: 한국어 · mood: calm"
            android:textSize="12sp"
            android:textColor="#666666" />

        <!-- RANKING 곡 언어 선택 (ko/en/ja) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="곡 언어 선택"
                android:textSize="14sp"
                android:textColor="#333333" />

            <Spinner
                android:id="@+id/spinner_lang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="160dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_track_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="420dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="재생 대기 중"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tv_track_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0"
            android:textSize="12sp"
            android:textColor="#666666" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:text="이전"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="120dp"
                android:text="재생"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minWidth="96dp"
                android:text="다음"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
